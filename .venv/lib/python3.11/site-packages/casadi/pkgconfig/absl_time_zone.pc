exec_prefix=${prefix}
libdir=/Users/runner/work/casadi/casadi/build/external_projects/lib
includedir=/Users/runner/work/casadi/casadi/build/external_projects/include

Name: absl_time_zone
Description: Abseil time_zone library
URL: https://abseil.io/
Version: 20250127
Requires:
