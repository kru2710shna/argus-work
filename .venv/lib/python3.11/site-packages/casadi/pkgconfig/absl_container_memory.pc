exec_prefix=${prefix}
libdir=/Users/runner/work/casadi/casadi/build/external_projects/lib
includedir=/Users/runner/work/casadi/casadi/build/external_projects/include

Name: absl_container_memory
Description: Abseil container_memory library
URL: https://abseil.io/
Version: 20250127
Requires: absl_config = 20250127, absl_memory = 20250127, absl_type_traits = 20250127, absl_utility = 20250127
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
