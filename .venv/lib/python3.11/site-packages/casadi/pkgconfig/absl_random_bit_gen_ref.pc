prefix=/Users/runner/work/casadi/casadi/build/external_projects
exec_prefix=${prefix}
libdir=/Users/runner/work/casadi/casadi/build/external_projects/lib
includedir=/Users/runner/work/casadi/casadi/build/external_projects/include

Name: absl_random_bit_gen_ref
Description: Abseil random_bit_gen_ref library
URL: https://abseil.io/
Version: 20250127
Requires: absl_config = 20250127, absl_core_headers = 20250127, absl_random_internal_distribution_caller = 20250127, absl_random_internal_fast_uniform_bits = 20250127, absl_type_traits = 20250127
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
